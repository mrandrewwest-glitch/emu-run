{
  "appId": "com.emurun.westy",
  "appName": "Emu Run",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1b120d",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#1b120d",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1b120d"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  },
  "android": {
    "backgroundColor": "#1b120d"
  }
}
